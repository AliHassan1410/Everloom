{%- comment -%}
  Wishlist page, mirroring the Everlooms React storefront's WishlistView
  (src/components/commerce/WishlistView.tsx). Saved product handles live in
  localStorage; product data is resolved client-side via Shopify's public
  /products/{handle}.js AJAX endpoint, so nothing here needs server state.
{%- endcomment -%}

<div class="everlooms-wishlist-page">
  <h1 class="everlooms-wishlist-page__title">My Wishlist</h1>
  <p class="everlooms-wishlist-page__subcopy">
    Saved in this browser — tap the heart on any product to add it here.
  </p>

  <div class="everlooms-wishlist-page__empty" id="everlooms-wishlist-empty" hidden>
    <p>Your wishlist is empty — tap the heart on any product to save it here.</p>
    <a href="{{ routes.root_url }}" class="button">Explore the collections</a>
  </div>

  <ul class="everlooms-wishlist-page__grid" id="everlooms-wishlist-grid"></ul>
</div>

{% stylesheet %}
  .everlooms-wishlist-page {
    max-width: 90rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .everlooms-wishlist-page__title {
    font-size: 1.75rem;
    font-weight: 600;
  }

  .everlooms-wishlist-page__subcopy {
    margin-top: 0.5rem;
    color: #666666;
    font-size: 0.875rem;
  }

  .everlooms-wishlist-page__empty {
    padding-block: 3rem;
    text-align: center;
  }

  .everlooms-wishlist-page__empty p {
    color: #666666;
    margin-bottom: 1.25rem;
  }

  .everlooms-wishlist-page__grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 16px;
  }

  @media screen and (min-width: 750px) {
    .everlooms-wishlist-page__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px 16px;
    }
  }

  .everlooms-wishlist-card {
    position: relative;
  }

  .everlooms-wishlist-card__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--style-border-radius-card, 4px);
    background: #f5f5f5;
  }

  .everlooms-wishlist-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .everlooms-wishlist-card__details {
    margin-top: 8px;
  }

  .everlooms-wishlist-card__category {
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #666666;
  }

  .everlooms-wishlist-card__title {
    margin: 2px 0 0;
    font-size: 1rem;
    font-weight: 400;
  }

  .everlooms-wishlist-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .everlooms-wishlist-card__price {
    margin: 4px 0 0;
    font-size: 1rem;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .everlooms-wishlist-card__price--compare {
    text-decoration: line-through;
    color: #999999;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wishlist content",
  "tag": "section",
  "settings": []
}
{% endschema %}
