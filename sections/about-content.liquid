{%- comment -%}
  Hardcoded About Us content, mirroring the Everlooms React storefront's
  /about page (src/app/(shop)/about/page.tsx + src/content/about.json) 1:1.
{%- endcomment -%}

<div class="everlooms-hero-banner">
  <img
    src="{{ 'everlooms-about-banner.webp' | asset_url }}"
    alt=""
    width="1920"
    height="1100"
    loading="eager"
  >
  <div class="everlooms-hero-banner__overlay">
    <h1 class="everlooms-hero-banner__heading">About Us</h1>
  </div>
</div>

<div class="everlooms-marketing-page">
  <div class="everlooms-about-grid">
    <div>
      <div class="everlooms-divider-bar" aria-hidden="true"></div>
      <h2>Who We Are</h2>
      <p>At Everlooms, luxury begins with what you wear closest to your skin. We are a refined essentials brand dedicated to crafting elevated garments for men and women who value sophistication, comfort, and uncompromising quality. Every Everlooms piece — from delicately structured bras and refined panties to expertly tailored boxers, vests, and trousers — is designed with precision and artistry. We source premium fabrics that feel exceptionally soft, breathable, and long-lasting, ensuring each garment offers a flawless fit and effortless elegance. We believe true style starts with exceptional foundations, and our collections are thoughtfully created to provide support, comfort, and a seamless silhouette beneath every outfit.</p>
    </div>
    <div class="everlooms-about-grid__image">
      <img
        src="{{ 'everlooms-about-who-we-are.webp' | asset_url }}"
        alt=""
        width="700"
        height="700"
        loading="lazy"
      >
    </div>
  </div>

  <div class="everlooms-closing">
    <p class="everlooms-closing__eyebrow">Thoughtfully created</p>
    <h2 class="everlooms-closing__heading">Foundations for every outfit.</h2>
    <a href="{{ routes.all_products_collection_url }}" class="button">Shop the Collection</a>
  </div>
</div>

{% render 'everlooms-marketing-page-styles' %}

{% schema %}
{
  "name": "About Us content",
  "tag": "section",
  "settings": []
}
{% endschema %}
