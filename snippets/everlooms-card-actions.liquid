{%- doc -%}
  Renders wishlist (heart) and quick-view (eye) icon buttons on a product card,
  matching the Everlooms React storefront's ProductCard action buttons.

  @param {object} product - The product object
{%- enddoc -%}

{% unless product == blank %}
  <div class="everlooms-card-actions">
    <button
      type="button"
      class="everlooms-card-actions__button everlooms-card-actions__button--wishlist"
      data-everlooms-wishlist-toggle
      data-product-handle="{{ product.handle }}"
      aria-pressed="false"
      aria-label="Add to wishlist"
    >
      <span
        class="svg-wrapper"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z" />
        </svg>
      </span>
    </button>

    <a
      href="{{ product.url }}"
      class="everlooms-card-actions__button everlooms-card-actions__button--view"
      aria-label="View product"
    >
      <span
        class="svg-wrapper"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          {% render 'icon', icon: 'eye' %}
        </svg>
      </span>
    </a>
  </div>

  {% render 'everlooms-card-actions-styles' %}
{% endunless %}
