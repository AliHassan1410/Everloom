{%- comment -%}
  Shared styling for hardcoded legal/content pages (privacy policy, refund policy, ...)
  that mirror the Everlooms React storefront's /info/[slug] page 1:1.
{%- endcomment -%}

{% stylesheet %}
  .everlooms-policy-page {
    max-width: 45rem;
    margin-inline: auto;
    padding: 2.5rem 1rem 5rem;
  }

  @media screen and (min-width: 750px) {
    .everlooms-policy-page {
      padding: 2.5rem 2rem 6rem;
    }
  }

  .everlooms-policy-breadcrumb {
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    color: #9a8d85;
  }

  .everlooms-policy-breadcrumb a {
    color: #9a8d85;
    text-decoration: none;
  }

  .everlooms-policy-breadcrumb a:hover {
    color: #2d6b7d;
  }

  .everlooms-policy-breadcrumb__sep {
    padding-inline: 0.25rem;
    color: #ddd4cf;
  }

  .everlooms-policy-breadcrumb span:last-child {
    color: #241e1c;
  }

  .everlooms-policy-title {
    font-family: var(--font-heading--family);
    font-size: 2.5rem;
    line-height: 1.04;
    letter-spacing: -0.01em;
    font-weight: 600;
    color: #241e1c;
    margin: 0;
  }

  .everlooms-policy-intro {
    margin-top: 0.5rem;
    max-width: 45rem;
    font-size: 1rem;
    line-height: 1.625;
    color: #52473f;
  }

  .everlooms-policy-sections {
    margin-top: 1rem;
  }

  .everlooms-policy-sections section {
    margin-top: 1.25rem;
  }

  .everlooms-policy-sections h2 {
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    line-height: 1.3;
    font-weight: 600;
    color: #241e1c;
    margin: 0;
  }

  .everlooms-policy-sections p {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.625;
    color: #52473f;
    white-space: pre-line;
  }

  .everlooms-policy-sections a,
  .everlooms-policy-intro a {
    color: #2d6b7d;
  }

  .everlooms-policy-confirmation-notice {
    margin-top: 1rem;
    max-width: 45rem;
    border: 1px solid rgba(165, 58, 58, 0.3);
    background: #fbefef;
    border-radius: 4px;
    padding: 0.75rem 0.875rem;
    font-size: 0.875rem;
    color: #8a5716;
  }

  .everlooms-policy-confirmation-notice strong {
    color: #8a5716;
  }
{% endstylesheet %}
