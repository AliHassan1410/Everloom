{% stylesheet %}
  .everlooms-card-actions {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease-out;
  }

  .card-gallery:hover .everlooms-card-actions,
  .card-gallery:focus-within .everlooms-card-actions,
  .everlooms-card-actions:has(.everlooms-card-actions__button[aria-pressed='true']) {
    opacity: 1;
    pointer-events: auto;
  }

  .everlooms-card-actions__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    color: #ffffff;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 150ms ease-out, transform 150ms ease-out;
  }

  .everlooms-card-actions__button:hover {
    background: #000000;
    transform: scale(1.05);
  }

  .everlooms-card-actions__button svg {
    width: 16px;
    height: 16px;
  }

  .everlooms-card-actions__button--wishlist[aria-pressed='true'] {
    color: #e0455f;
  }

  .everlooms-card-actions__button--wishlist[aria-pressed='true'] svg {
    fill: currentColor;
  }
{% endstylesheet %}
