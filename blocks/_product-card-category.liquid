{%- doc -%}
  Renders the product's category (product type) above the title on a product
  card, matching the Everlooms React storefront's ProductCard category label
  (e.g. "KNITTED BOXERS").
{%- enddoc -%}

{% if closest.product != blank and closest.product.type != blank %}
  {% assign category_html = '<p class="everlooms-card-category">' | append: closest.product.type | append: '</p>' %}
  {% render 'text', fallback_text: category_html, block: block, class: 'everlooms-card-category-wrap' %}
{% endif %}

{% render 'everlooms-card-category-styles' %}

{% schema %}
{
  "name": "Category label",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the product's category (type), e.g. \"Knitted Boxer\", above the title. Pulled automatically from the product's type field."
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        { "value": "fit-content", "label": "t:options.fit" },
        { "value": "100%", "label": "t:options.fill" }
      ],
      "default": "fit-content"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left",
      "visible_if": "{{ block.settings.width == '100%' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Category label",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
